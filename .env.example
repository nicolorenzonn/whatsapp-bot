# ════════════════════════════════════════════════════════════════════════
# WhatsApp Broadcaster bot — variables de entorno
# ════════════════════════════════════════════════════════════════════════
# En local: copiá este archivo a .env y completá los valores.
# En Railway: pegá estos valores en Variables → Project (no necesitás .env).
# ════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────
# Apuntá al MISMO proyecto que la SPA (control-financiero). Settings → API.
# Importante: SERVICE_ROLE, no ANON. El bot bypassa RLS y filtra manualmente
# por user_id en cada query.
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# UUID del usuario al que pertenece este bot. Sacalo del SQL editor:
#   SELECT id, email FROM auth.users;
WSP_BOT_USER_ID=00000000-0000-0000-0000-000000000000

# ── Pairing ───────────────────────────────────────────────────────────
# Si está seteado, `npm run pair` usa PAIRING CODE (sin QR) — Baileys pide
# a WhatsApp un código de 8 caracteres y lo imprime en logs. Vos lo entrás
# en el celu en:
#   WhatsApp → Configuración → Dispositivos vinculados →
#   Vincular un dispositivo → "Vincular con número de teléfono" (abajo)
#
# Esto es lo que usás en Railway / cloud (no podés escanear QR de la
# terminal del container). Formato: número internacional sin "+" ni
# espacios. Ej Argentina celular: 5491134567890
#
# En local podés dejarlo vacío y `npm run pair` muestra el QR clásico.
WSP_PAIRING_PHONE=

# ── IA opcional ───────────────────────────────────────────────────────
# Anthropic API key — sólo si vas a usar `variar_con_ia=1` en tareas.
# Reescribe el mensaje levemente con Claude antes de enviar para evitar
# detección por repetición exacta. Si no la pones, la opción se desactiva.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Persistencia ──────────────────────────────────────────────────────
# Path donde Baileys guarda los archivos de auth (la sesión pareada).
# En Railway montá un volumen persistente en este path:
#   Service → Settings → Volumes → New Volume → mount /app/auth
# Si lo perdés, hay que volver a parear (npm run pair).
WSP_AUTH_DIR=./auth

# ── Healthcheck (Railway) ─────────────────────────────────────────────
# Puerto del HTTP server con GET /healthz. Railway inyecta PORT
# automáticamente — solo seteá si querés overridearlo (default 8080).
# PORT=8080

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Telegram (GramJS / MTProto) — opcional ────────────────────────────
# Habilita el bot para leer mensajes de canales Telegram que seguís
# (con la cuenta de Telegram del mismo cel) y disparar el pipeline de
# auto-forward hacia WhatsApp (Claude reescribe + suffix).
#
# Cómo obtener API_ID + API_HASH:
#   https://my.telegram.org → Log in → API development tools →
#   Create app → copiar api_id y api_hash.
#
# Cómo obtener TELEGRAM_SESSION:
#   1. Setear TELEGRAM_API_ID + TELEGRAM_API_HASH en tu .env local.
#   2. Correr: npm run telegram-pair
#   3. Ingresar teléfono + código SMS + 2FA (si aplica).
#   4. Al final imprime TELEGRAM_SESSION=xxxxx — copialo.
#   5. Setealo en Railway → Variables → TELEGRAM_SESSION.
#
# Si estas tres vars están vacías, el bot ignora Telegram y sigue
# funcionando solo con WhatsApp — no es fatal.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
